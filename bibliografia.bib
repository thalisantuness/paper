@inproceedings{101145,
author = {Silva, Juan M. and Mouttham, Alain and El Saddik, Abdulmotaleb},
title = {UbiMeds: A Mobile Application to Improve Accessibility and Support Medication Adherence},
year = {2009},
isbn = {9781605587646},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez96.periodicos.capes.gov.br/10.1145/1631097.1631109},
doi = {10.1145/1631097.1631109},
abstract = {In this paper, we present UbiMeds, a mobile application and architecture that aims at supporting prescription medication adherence for aging and disabled population. We review the problem of medication adherence in general and from the accessibility perspective. We describe the design process guided by the accessibility issues identified in the non-adherence phenomenon. We present a proposed comprehensive architecture (including an iPhone application) aimed at improving accessibility in the practice of medication taking from patients, and supporting the intake tracking and monitoring by physicians and family members.},
booktitle = {Proceedings of the 1st ACM SIGMM International Workshop on Media Studies and Implementations That Help Improving Access to Disabled Users},
pages = {71–78},
numpages = {8},
keywords = {ubiquitous web, mobile computing, web services, medication adherence, ambient intelligence},
location = {Beijing, China},
series = {MSIADU '09}
}
@inproceedings{101109,
author = {Mukhiya, Suresh Kumar and Rabbi, Fazle and Pun, Ka I and Lamo, Yngve},
title = {An Architectural Design for Self-Reporting e-Health Systems},
year = {2019},
publisher = {IEEE Press},
url = {https://doi-org.ez96.periodicos.capes.gov.br/10.1109/SEH.2019.00008},
doi = {10.1109/SEH.2019.00008},
abstract = {Worldwide, public healthcare is challenged to deliver consistent and cost-efficient services. The cost of healthcare is increasing primarily due to growing populations and more expensive treatment. Health facilities in many countries are reaching their full operational capacity, and their resources are less than what is required to deliver the expected quality of care. Under these circumstances, ICT has a major role to play in mitigating the growing need for hospital care. In this paper, we present a cloud-based interoperable architecture built on the top of Service-Oriented Architecture (SOA) for Internet-based treatment where patients can directly interact with underlying healthcare systems such as Electronic Health Records (EHRs). Based on this architecture, we also present a prototype for screening and monitoring of mental and neurological health morbidities. The proposed solution is based on the healthcare interoperability standard, HL7 FHIR, that enables healthcare providers to assess and monitor patients condition in a secure environment.},
booktitle = {Proceedings of the 1st International Workshop on Software Engineering for Healthcare},
pages = {1–8},
numpages = {8},
keywords = {SMART on FHIR, HL7 FHIR, healthcare, internet-based treatments, self-screening, service-oriented architecture},
location = {Montreal, Quebec, Canada},
series = {SEH '19}
}

@inproceedings{1011455,
author = {Koumpouros, Yiannis},
title = {A Highly User-Centered Design Approach for Developing a Mobile Health App for Pain Management (PainApp)},
year = {2021},
isbn = {9781450387927},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez96.periodicos.capes.gov.br/10.1145/3453892.3461350},
doi = {10.1145/3453892.3461350},
abstract = {The paper presents the design of a mobile application targeting people suffering from chronic or acute pain. The final solution supports the management, reporting and treatment effectiveness monitoring. The proposed PainApp solution runs on Android Smartphones. The paper presents a concrete methodological plan in order to build mobile health applications. The methodology followed was highly interdisciplinary. A participatory design with a team of seventeen stakeholders drove the design and development phases. An interdisciplinary team of experts (physicians, psychologists, IT experts) collaborated with ten patients in order to develop the PainApp solution. The paper focuses on the methodological approach giving insights on the actual plan and the steps followed for having a patient-centric solution. Key success factors and obstacles faced on mobile health applications support the need for such an approach. The several features implemented are presented in details.},
booktitle = {The 14th PErvasive Technologies Related to Assistive Environments Conference},
pages = {320–329},
numpages = {10},
keywords = {Wearable, Smartphone, Mobile health, ICT, Application, mHealth, Information and Communication Technologies, Pain, Mobile, Assistive technology},
location = {Corfu, Greece},
series = {PETRA 2021}
}

@inproceedings{3129783,
author = {Scholz, Birgit and Sachs, Michael and Zhu, Lei and Egger-Sidlo, Georg},
title = {A Smooth and Smart Integrated Mobile Concept for Parallelizing and "Virtualizing" the Austrian Health ID Card},
year = {2017},
isbn = {9781450354127},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi-org.ez96.periodicos.capes.gov.br/10.1145/3129757.3129783},
doi = {10.1145/3129757.3129783},
abstract = {The project "Mobile eCard" aims to create a concept of an e-health smartphone application, based on an existing secure identity. By building on the existing ID infrastructure of the Austrian Health ID Card (GINA boxes, O-card, etc.) a demonstrator app shows the feasibility of transferring all current major functionalities of the Austrian Health ID Card onto a smartphone in a safe and user-friendly way. Ideally, additional use cases beyond the current possibilities of the national health ID card can be demonstrated as well. This paper presents basic use cases and the technical concept of the project.},
booktitle = {Proceedings of the Internationsl Conference on Electronic Governance and Open Society: Challenges in Eurasia},
pages = {152–159},
numpages = {8},
keywords = {e-health, ICT, m-health, e-services, mobile applications},
location = {St. Petersburg, Russia},
series = {eGose '17}
}

